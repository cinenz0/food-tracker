{
  "name": "food-tracker",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "assets": {"directory": "../ui", "binding": "ASSETS", "run_worker_first": true},
  "observability": {"enabled": false},
  "vars": {"GEMINI_MODEL": "gemini-3.5-flash-lite"}
  // Configure SUPABASE_URL, SUPABASE_ANON_KEY, OWNER_EMAIL and GEMINI_API_KEY as secrets.
}
